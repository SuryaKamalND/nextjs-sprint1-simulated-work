# .env.example - template for new developers (safe to commit: placeholders only)
# Copy to .env.local and fill in real values:  cp .env.example .env.local

# ---------- Server-only secrets (NEVER prefix these with NEXT_PUBLIC_) ----------
# Postgres connection string used by the server/ORM
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# Secret key for calling internal/third-party APIs from the server
API_SECRET_KEY=sk_test_your_key_here
# Secret used to sign and verify JWT session tokens
JWT_SECRET=your_jwt_secret_here
# Stripe secret key (server-side payments only)
STRIPE_SECRET_KEY=sk_test_stripe_key_here

# ---------- Public variables (exposed to the browser; never put secrets here) ----------
# Base URL the client uses to call our API
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Display name of the app
NEXT_PUBLIC_APP_NAME=Our Product
# Stripe publishable key (designed to be public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_stripe_key_here
# Google Analytics measurement ID
NEXT_PUBLIC_ANALYTICS_ID=GA-XXXXXXXXX

# ---------- Auth (NextAuth) ----------
# Base URL of the app (used for callbacks)
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign/encrypt session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_a_long_random_secret
